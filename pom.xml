<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.zyneonstudios.apex</groupId>
    <name>NEX App</name>
    <artifactId>NEX_App</artifactId>
    <version>4.0.1</version>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>4.1.1</version>
        </dependency>

        <dependency>
            <groupId>io.avaje.webview</groupId>
            <artifactId>avaje-webview</artifactId>
            <version>0.29</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${project.basedir}/src/frontend/dist</directory>
                        </fileset>
                        <fileset>
                            <directory>${project.basedir}/src/main/resources/static</directory>
                        </fileset>
                    </filesets>
                </configuration>
                <executions>
                    <execution>
                        <id>clean-old-static-resources</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}/static</directory>
                                </fileset>
                                <fileset>
                                    <directory>${project.basedir}/src/frontend/dist</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.1.1</version>
                <configuration>
                    <jvmArguments>
                        --add-modules jdk.unsupported.desktop --add-exports java.desktop/jdk.swing.interop=ALL-UNNAMED
                    </jvmArguments>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <workingDirectory>src/frontend</workingDirectory>
                    <nodeVersion>v24.20.0</nodeVersion>
                    <pnpmVersion>11.22.0</pnpmVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>install node and pnpm</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-pnpm</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>pnpm install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pnpm run build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>pnpm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>copy-frontend-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete file="${project.build.directory}/${project.build.finalName}.jar.original"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.8.0</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <input>${project.build.directory}</input>
                                    <destination>${project.build.directory}/jpackage</destination>
                                    <name>${name}</name>
                                    <appVersion>${version}</appVersion>
                                    <vendor>Zyneon Apex</vendor>
                                    <mainJar>${project.build.finalName}.jar</mainJar>
                                    <mainClass>org.springframework.boot.loader.launch.JarLauncher</mainClass>
                                    <icon>${project.basedir}/src/main/resources/icon.ico</icon>
                                    <type>APP_IMAGE</type>
                                    <winConsole>true</winConsole>
                                    <javaOptions>
                                        <option>--add-modules</option>
                                        <option>jdk.unsupported.desktop</option>
                                        <option>--add-exports</option>
                                        <option>java.desktop/jdk.swing.interop=ALL-UNNAMED</option>
                                    </javaOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>linux-x86_64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <appimage.arch>x86_64</appimage.arch>
                <jre.source.folder>Azul_Zulu-JRE-x86_64</jre.source.folder>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete file="${project.build.directory}/${project.build.finalName}.jar.original"/>
                                        <delete dir="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/lib/jre" quiet="true"/>
                                        <copy todir="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/lib/jre">
                                            <fileset dir="${project.basedir}/build/${jre.source.folder}"/>
                                        </copy>
                                        <chmod dir="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/lib/jre/bin" perm="755" includes="*"/>

                                        <delete dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/assets/jre" quiet="true"/>
                                        <copy todir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/assets/jre">
                                            <fileset dir="${project.basedir}/build/${jre.source.folder}"/>
                                        </copy>
                                        <chmod dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/assets/jre/bin" perm="755" includes="*"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/bin/NEX_App.jar" />
                                        <chmod file="${project.basedir}/build/appimagetool-${appimage.arch}.AppImage" perm="755" />

                                        <exec executable="./appimagetool-${appimage.arch}.AppImage" dir="${project.basedir}/build" failonerror="true">
                                            <env key="ARCH" value="${appimage.arch}" />
                                            <arg value="NEX_App-${appimage.arch}.AppDir" />
                                            <arg value="NEX_App-${project.version}-${appimage.arch}.AppImage" />
                                        </exec>
                                        <move file="${project.basedir}/build/NEX_App-${project.version}-${appimage.arch}.AppImage" todir="${project.build.directory}" />
                                        <delete file="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/.DirIcon" />
                                        <delete file="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/bin/NEX_App.jar" />
                                        <delete dir="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/lib/jre" quiet="true"/>

                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/nex-app.jar" />
                                        <exec executable="flatpak-builder" dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak" failonerror="true">
                                            <arg value="--arch=${appimage.arch}"/>
                                            <arg value="--repo=repo"/>
                                            <arg value="--force-clean"/>
                                            <arg value="build-dir"/>
                                            <arg value="com.zyneonstudios.apex.nexapp.json"/>
                                        </exec>
                                        <exec executable="flatpak" dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak" failonerror="true">
                                            <arg value="build-bundle"/>
                                            <arg value="--arch=${appimage.arch}"/>
                                            <arg value="repo"/>
                                            <arg value="NEX_App-${project.version}-${appimage.arch}.flatpak"/>
                                            <arg value="com.zyneonstudios.apex.nexapp"/>
                                        </exec>
                                        <move file="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/NEX_App-${project.version}-${appimage.arch}.flatpak" todir="${project.build.directory}"/>
                                        <delete dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/repo"/>
                                        <delete file="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/nex-app.jar"/>
                                        <delete dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/assets/jre" quiet="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>linux-aarch64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <appimage.arch>aarch64</appimage.arch>
                <jre.source.folder>Azul_Zulu-JRE-aarch64</jre.source.folder>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete file="${project.build.directory}/${project.build.finalName}.jar.original"/>
                                        <delete dir="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/lib/jre" quiet="true"/>
                                        <copy todir="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/lib/jre">
                                            <fileset dir="${project.basedir}/build/${jre.source.folder}"/>
                                        </copy>
                                        <chmod dir="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/lib/jre/bin" perm="755" includes="*"/>

                                        <delete dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/assets/jre" quiet="true"/>
                                        <copy todir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/assets/jre">
                                            <fileset dir="${project.basedir}/build/${jre.source.folder}"/>
                                        </copy>
                                        <chmod dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/assets/jre/bin" perm="755" includes="*"/>

                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/bin/NEX_App.jar" />
                                        <chmod file="${project.basedir}/build/appimagetool-${appimage.arch}.AppImage" perm="755" />
                                        <exec executable="./appimagetool-${appimage.arch}.AppImage" dir="${project.basedir}/build" failonerror="true">
                                            <env key="ARCH" value="${appimage.arch}" />
                                            <arg value="NEX_App-${appimage.arch}.AppDir" />
                                            <arg value="NEX_App-${project.version}-${appimage.arch}.AppImage" />
                                        </exec>
                                        <move file="${project.basedir}/build/NEX_App-${project.version}-${appimage.arch}.AppImage" todir="${project.build.directory}" />
                                        <delete file="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/.DirIcon" />
                                        <delete file="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/bin/NEX_App.jar" />
                                        <delete dir="${project.basedir}/build/NEX_App-${appimage.arch}.AppDir/usr/lib/jre" quiet="true"/>

                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/nex-app.jar" />
                                        <exec executable="flatpak-builder" dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak" failonerror="true">
                                            <arg value="--arch=${appimage.arch}"/>
                                            <arg value="--repo=repo"/>
                                            <arg value="--force-clean"/>
                                            <arg value="build-dir"/>
                                            <arg value="com.zyneonstudios.apex.nexapp.json"/>
                                        </exec>
                                        <exec executable="flatpak" dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak" failonerror="true">
                                            <arg value="build-bundle"/>
                                            <arg value="--arch=${appimage.arch}"/>
                                            <arg value="repo"/>
                                            <arg value="NEX_App-${project.version}-${appimage.arch}.flatpak"/>
                                            <arg value="com.zyneonstudios.apex.nexapp"/>
                                        </exec>
                                        <move file="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/NEX_App-${project.version}-${appimage.arch}.flatpak" todir="${project.build.directory}"/>
                                        <delete dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/repo"/>
                                        <delete file="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/nex-app.jar"/>
                                        <delete dir="${project.basedir}/build/NEX_App-${appimage.arch}-flatpak/assets/jre" quiet="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>